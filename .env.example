# ==============================================================================
# Koyla: CIL / CMPDI Reporting Intelligence Platform
# Environment Configuration Template (.env.example)
#
# Copy this file to .env and adjust values for your deployment environment.
# NEVER commit the actual .env file to version control.
# ==============================================================================

# Core Platform Settings
PROJECT_NAME="Koyla - CIL/CMPDI Reporting Intelligence"
API_V1_STR="/api/v1"
SECRET_KEY="replace_with_a_secure_random_secret_key_in_production"
ACCESS_TOKEN_EXPIRE_MINUTES=11520

# ------------------------------------------------------------------------------
# 1. Database Connection (PostgreSQL 16 + pgvector)
# ------------------------------------------------------------------------------
# DOCKER DEPLOYMENT (Default in docker-compose.yml):
# DATABASE_URL="postgresql+psycopg2://postgres:postgres@postgres:5432/koyla"
#
# STANDALONE HOST / LOCAL PYTHON DEVELOPMENT:
DATABASE_URL="postgresql+psycopg2://postgres:postgres@localhost:5432/koyla"

# Storage Configuration
STORAGE_DIR="storage/documents"

# Reconciliation Policy Threshold (relative variance, e.g. 0.01 = 1%)
RECONCILIATION_VARIANCE_THRESHOLD=0.01

# ------------------------------------------------------------------------------
# 2. Local Embedding & Vector Search Configuration
# ------------------------------------------------------------------------------
# Options: "sentence_transformers" (primary neural) or "deterministic" (zero-download hash fallback)
EMBEDDING_PROVIDER="sentence_transformers"
NEURAL_MODEL_NAME="BAAI/bge-small-en-v1.5"
NEURAL_MODEL_PATH="backend/model_cache/BAAI/bge-small-en-v1.5"
EMBEDDING_DIMENSION=384
EMBEDDING_BATCH_SIZE=32

# Offline / Air-gapped Operation Controls
# Set to 1 to prevent outbound network retries when running in air-gapped environments:
TRANSFORMERS_OFFLINE=0
HF_HUB_OFFLINE=0
OFFLINE_MODE=0

# ------------------------------------------------------------------------------
# 3. Hybrid Retrieval & Reranking Settings
# ------------------------------------------------------------------------------
RRF_K=60
RRF_KEYWORD_WEIGHT=1.0
RRF_DENSE_WEIGHT=1.0
ENABLE_RERANKER=true
RERANKER_MODEL_NAME="cross-encoder/ms-marco-MiniLM-L-6-v2"
DEFAULT_SEARCH_TOP_K=10

# ------------------------------------------------------------------------------
# 4. Local LLM & Grounded Q&A Settings
# ------------------------------------------------------------------------------
LLM_PROVIDER="ollama"

# DOCKER DEPLOYMENT (Bridges to host-managed Ollama daemon):
# OLLAMA_BASE_URL="http://host.docker.internal:11434"
#
# STANDALONE HOST / LOCAL PYTHON DEVELOPMENT:
OLLAMA_BASE_URL="http://localhost:11434"

OLLAMA_MODEL="SmolLM2-135M-Instruct"
OPENAI_COMPATIBLE_BASE_URL="http://localhost:11434/v1"
OPENAI_COMPATIBLE_MODEL="SmolLM2-135M-Instruct"
LOCAL_MODEL_NAME="SmolLM2-135M-Instruct"
LOCAL_MODEL_PATH="backend/model_cache/SmolLM2-135M-Instruct"
LLM_TIMEOUT_SECONDS=30.0
LLM_TEMPERATURE=0.1
QA_REFUSAL_THRESHOLD=0.015
ENABLE_ARITHMETIC_ENGINE=true
ENABLE_GROUNDING_VERIFICATION=true
MAX_EVIDENCE_CHUNKS=5
