# ==============================================================================
# Koyla: CIL / CMPDI Reporting Intelligence Platform
# Environment Configuration Template (.env.example)
#
# Copy this file to .env and adjust values for your deployment environment.
# NEVER commit the actual .env file to version control.
# ==============================================================================

# Core Platform Settings
PROJECT_NAME="Koyla - CIL/CMPDI Reporting Intelligence"
API_V1_STR="/api/v1"
ENVIRONMENT="development"  # "development", "testing", or "production"
SECRET_KEY="replace_with_a_secure_random_secret_key_in_production"
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ------------------------------------------------------------------------------
# 1. Database Connection (PostgreSQL 16 + pgvector)
# ------------------------------------------------------------------------------
# DOCKER DEPLOYMENT (Default in docker-compose.yml):
# DATABASE_URL="postgresql+psycopg2://postgres:postgres@postgres:5432/koyla"
#
# STANDALONE HOST / LOCAL PYTHON DEVELOPMENT:
DATABASE_URL="postgresql+psycopg2://postgres:postgres@localhost:5432/koyla"

# Storage Configuration
STORAGE_DIR="storage/documents"
STORAGE_QUARANTINE_DIR="storage/quarantine"
REPORTS_DIR="data/reports"

# ------------------------------------------------------------------------------
# 2. Asynchronous Task Processing (Celery & Redis - H1)
# ------------------------------------------------------------------------------
REDIS_URL="redis://localhost:6379/0"
CELERY_BROKER_URL="redis://localhost:6379/0"
CELERY_RESULT_BACKEND="redis://localhost:6379/1"
CELERY_TASK_ALWAYS_EAGER=false

# ------------------------------------------------------------------------------
# 3. Security Hardening & Rate Limiting (H4)
# ------------------------------------------------------------------------------
MAX_UPLOAD_SIZE_BYTES=104857600  # 100 MB max upload
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_PER_MINUTE=120
RATE_LIMIT_QA_PER_MINUTE=120
RATE_LIMIT_UPLOAD_PER_MINUTE=120

# Antivirus / ClamAV Scanner Settings (Air-gapped by default)
CLAMAV_ENABLED=false
CLAMAV_REQUIRED=false
CLAMAV_HOST="localhost"
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_SECONDS=5.0

# ------------------------------------------------------------------------------
# 4. Identity Provider & LDAP/AD Integration (H5)
# ------------------------------------------------------------------------------
IDENTITY_PROVIDER="local"  # "local" (default local JWT) or "ldap"
LDAP_SERVER_URL=
LDAP_BASE_DN=
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
LDAP_USER_SEARCH_BASE=
LDAP_USER_SEARCH_FILTER="(&(objectClass=person)(sAMAccountName={username}))"
LDAP_GROUP_SEARCH_BASE=
LDAP_GROUP_SEARCH_FILTER="(&(objectClass=group)(member={user_dn}))"
LDAP_USE_TLS=true
LDAP_ROLE_MAPPING_JSON=  # Optional JSON mapping: {"CN=Admins,...": "SYSTEM_ADMIN"}

# ------------------------------------------------------------------------------
# 5. Enterprise System Adapters (H6)
# ------------------------------------------------------------------------------
SAP_ENABLED=false
SAP_BASE_URL=
SAP_CLIENT_ID=
SAP_CLIENT_SECRET=
SAP_TIMEOUT_SECONDS=5.0
SAP_VERIFY_TLS=true

COALNET_ENABLED=false
COALNET_BASE_URL=
COALNET_API_KEY=
COALNET_TIMEOUT_SECONDS=5.0
COALNET_VERIFY_TLS=true

DMS_ENABLED=false
DMS_BASE_URL=
DMS_AUTH_TOKEN=
DMS_TIMEOUT_SECONDS=5.0
DMS_VERIFY_TLS=true

# ------------------------------------------------------------------------------
# 6. Local Embedding & Vector Search Configuration
# ------------------------------------------------------------------------------
# Options: "sentence_transformers" (primary neural) or "deterministic" (zero-download hash fallback)
EMBEDDING_PROVIDER="sentence_transformers"
NEURAL_MODEL_NAME="BAAI/bge-small-en-v1.5"
NEURAL_MODEL_PATH="backend/model_cache/BAAI/bge-small-en-v1.5"
EMBEDDING_DIMENSION=384
EMBEDDING_BATCH_SIZE=32

# Offline / Air-gapped Operation Controls
# Set to 1 to prevent outbound network calls when running in air-gapped environments:
TRANSFORMERS_OFFLINE=0
HF_HUB_OFFLINE=0
OFFLINE_MODE=0

# ------------------------------------------------------------------------------
# 7. Hybrid Retrieval & Reranking Settings
# ------------------------------------------------------------------------------
RRF_K=60
RRF_KEYWORD_WEIGHT=1.0
RRF_DENSE_WEIGHT=1.0
ENABLE_RERANKER=true
RERANKER_MODEL_NAME="cross-encoder/ms-marco-MiniLM-L-6-v2"
DEFAULT_SEARCH_TOP_K=10

# ------------------------------------------------------------------------------
# 8. Local LLM & Grounded Q&A Settings
# ------------------------------------------------------------------------------
LLM_PROVIDER="ollama"

# DOCKER DEPLOYMENT (Bridges to host-managed Ollama daemon):
# OLLAMA_BASE_URL="http://host.docker.internal:11434"
#
# STANDALONE HOST / LOCAL PYTHON DEVELOPMENT:
OLLAMA_BASE_URL="http://localhost:11434"

OLLAMA_MODEL="SmolLM2-135M-Instruct"
OPENAI_COMPATIBLE_BASE_URL="http://localhost:11434/v1"
OPENAI_COMPATIBLE_MODEL="SmolLM2-135M-Instruct"
LOCAL_MODEL_NAME="SmolLM2-135M-Instruct"
LOCAL_MODEL_PATH="backend/model_cache/SmolLM2-135M-Instruct"
LLM_TIMEOUT_SECONDS=30.0
LLM_TEMPERATURE=0.1
QA_REFUSAL_THRESHOLD=0.015
ENABLE_ARITHMETIC_ENGINE=true
ENABLE_GROUNDING_VERIFICATION=true
MAX_EVIDENCE_CHUNKS=5

# ------------------------------------------------------------------------------
# 9. Visual Classifier Settings (H7)
# ------------------------------------------------------------------------------
VISUAL_CLASSIFIER="heuristic"  # "heuristic" (default) or "domain_cv"
VISUAL_HIGH_CONFIDENCE_THRESHOLD=0.70
VISUAL_LOW_CONFIDENCE_THRESHOLD=0.40
VISUAL_DOMAIN_MODEL_PATH=
VISUAL_MAX_IMAGE_PIXELS=50000000
VISUAL_OCR_CONFIDENCE_MIN=0.70
VISUAL_DETECTION_DPI=150
VISUAL_MIN_IMAGE_SIZE=50
VISUAL_CLASSIFICATION_CONFIDENCE_MIN=0.5

# ------------------------------------------------------------------------------
# 10. Backup, Restore & Disaster Recovery (H9)
# ------------------------------------------------------------------------------
BACKUP_DIR="data/backups"
BACKUP_RETENTION_COUNT=5
BACKUP_INCLUDE_DATABASE=true
BACKUP_INCLUDE_DOCUMENTS=true
BACKUP_INCLUDE_REPORTS=true
